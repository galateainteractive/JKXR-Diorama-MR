		// Diorama MR uses a text guide because its external-camera controls
		// differ substantially from the inherited immersive VR scheme.
		itemDef
		{
			group						none
			name						diorama_help_title
			type						ITEM_TYPE_TEXT
			text						"DIORAMA MR CONTROLS"
			rect						60 42 520 18
			font						3
			textscale				0.8
			textalign				ITEM_ALIGN_CENTER
			textalignx				260
			forecolor				.549 .854 1 1
			visible					1
			cvarTest				show_help_item
			showCvar				{ 10 }
			decoration
		}

