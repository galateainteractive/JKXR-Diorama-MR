		// ITEM_TYPE_TEXT does not wrap. Keep every Diorama MR help row short and
		// split longer explanations into explicit lines so the guide remains
		// readable on the curved in-headset menu surface.
		itemDef
		{
			group none name diorama_help_panel
			rect 20 15 600 450 style WINDOW_STYLE_FILLED backcolor .02 .03 .05 .94 visible 1
			cvarTest show_help_item showCvar { 10 } decoration
		}
		itemDef
		{
			group none name diorama_help_title type ITEM_TYPE_TEXT text "DIORAMA MR CONTROLS"
			rect 60 38 520 18 font 3 textscale 0.8 textalign ITEM_ALIGN_CENTER textalignx 260
			forecolor .549 .854 1 1 visible 1 cvarTest show_help_item showCvar { 10 } decoration
		}
		itemDef
		{
			group none name none type ITEM_TYPE_TEXT text "DEFAULT RIGHT-HANDED LAYOUT"
			rect 60 63 520 14 font 2 textscale 0.58 textalign ITEM_ALIGN_CENTER textalignx 260
			forecolor .8 .8 .9 1 visible 1 cvarTest show_help_item showCvar { 10 } decoration
		}
		itemDef
		{
			group none name none type ITEM_TYPE_TEXT text "Left-handed mode swaps dominant-hand and off-hand roles."
			rect 60 77 520 14 font 2 textscale 0.58 textalign ITEM_ALIGN_CENTER textalignx 260
			forecolor .8 .8 .9 1 visible 1 cvarTest show_help_item showCvar { 10 } decoration
		}

