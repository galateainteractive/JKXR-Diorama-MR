//----------------------------------------------------------------------------------------------
// Diorama MR two-player LAN co-op menu
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name				"coopMenu"
		fullScreen			1
		rect				0 0 640 480
		visible				1
		focusColor			1 1 1 1
		descX				320
		descY				426
		descScale			0.8
		descColor			1 .682 0 .8
		descAlignment			ITEM_ALIGN_CENTER

		onOpen
		{
			setfocus			coopMapList
			uiScript			coopRefresh
		}

		onESC
		{
			play			"sound/interface/esc.wav"
			close			all
			open			mainMenu
		}

		itemDef
		{
			name				background_text
			style				WINDOW_STYLE_SHADER
			rect				0 0 160 480
			background			"gfx/menus/menu_side_text"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				background_text_b
			style				WINDOW_STYLE_SHADER
			rect				480 0 160 480
			background			"gfx/menus/menu_side_text_right"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				background
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"gfx/menus/main_background"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				center_panel
			style				WINDOW_STYLE_FILLED
			rect				20 62 600 354
			backcolor			0 0 .18 .72
			border				1
			bordersize			1
			bordercolor			0 0 .8 1
			visible				1
			decoration
		}

		itemDef
		{
			name				title
			type				ITEM_TYPE_TEXT
			style				WINDOW_STYLE_EMPTY
			rect				100 72 440 24
			text				"CO-OP - LOCAL NETWORK"
			font				3
			textscale			0.9
			textalign			ITEM_ALIGN_CENTER
			textalignx			220
			textaligny			0
			forecolor			.549 .854 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				host_title
			type				ITEM_TYPE_TEXT
			rect				35 108 270 18
			text				"HOST A LEVEL"
			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			135
			forecolor			1 .682 0 1
			visible				1
			decoration
		}

		itemDef
		{
			name				coopMapList
			group				coop_lists
			rect				35 132 270 178
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth			250
			elementheight			18
			elementtype			LISTBOX_TEXT
			feeder				25
			columns				1 0 0 38
			font				2
			textscale			0.65
			border				1
			bordersize			1
			bordercolor			0 0 .8 1
			forecolor			.615 .615 .956 1
			backcolor			0 0 .5 .25
			outlinecolor			.2 .45 .8 .55
			visible				1
			mouseEnter { setitemcolor coopMapList bordercolor 1 1 1 1 }
			mouseExit  { setitemcolor coopMapList bordercolor 0 0 .8 1 }
		}

		itemDef
		{
			name				coop_loadout
			type				ITEM_TYPE_MULTI
			rect				45 326 250 18
			text				"STARTING LOADOUT"
			cvar				"g_coopLoadout"
			cvarFloatList
			{
				"STORY DEFAULT" 0
				"LIGHTSABER" 1
				"LIGHTSABER + BLASTER" 2
			}
			font				2
			textscale			0.55
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			forecolor			.615 .615 .956 1
			visible				1
			descText			"Starting weapons given to both players"
		}

		itemDef
		{
			name				host_button
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			rect				70 370 200 28
			text				"HOST"
			descText			"Start the selected level for two players"
			font				3
			textscale			0.8
			textalign			ITEM_ALIGN_CENTER
			textalignx			100
			textaligny			0
			forecolor			1 .682 0 1
			backcolor			0 0 .35 .8
			border				1
			bordercolor			0 0 .8 1
			visible				1
			mouseEnter { setitemcolor host_button bordercolor 1 1 1 1 }
			mouseExit  { setitemcolor host_button bordercolor 0 0 .8 1 }
			action
			{
				play			"sound/interface/button1.wav"
				close			all
				uiScript			coopStart
			}
		}

		itemDef
		{
			name				join_title
			type				ITEM_TYPE_TEXT
			rect				335 108 270 18
			text				"GAMES FOUND"
			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			135
			forecolor			1 .682 0 1
			visible				1
			decoration
		}

		itemDef
		{
			name				coopServerList
			group				coop_lists
			rect				335 132 270 132
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth			250
			elementheight			20
			elementtype			LISTBOX_TEXT
			feeder				24
			columns				1 0 0 40
			font				2
			textscale			0.62
			border				1
			bordersize			1
			bordercolor			0 0 .8 1
			forecolor			.615 .615 .956 1
			backcolor			0 0 .5 .25
			outlinecolor			.2 .45 .8 .55
			visible				1
			mouseEnter { setitemcolor coopServerList bordercolor 1 1 1 1 }
			mouseExit  { setitemcolor coopServerList bordercolor 0 0 .8 1 }
		}

		itemDef
		{
			name				refresh_button
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			rect				350 282 110 26
			text				"REFRESH"
			descText			"Search again for games on the same Wi-Fi network"
			font				3
			textscale			0.65
			textalign			ITEM_ALIGN_CENTER
			textalignx			55
			forecolor			1 .682 0 1
			backcolor			0 0 .35 .8
			border				1
			bordercolor			0 0 .8 1
			visible				1
			mouseEnter { setitemcolor refresh_button bordercolor 1 1 1 1 }
			mouseExit  { setitemcolor refresh_button bordercolor 0 0 .8 1 }
			action
			{
				play			"sound/interface/button1.wav"
				uiScript			coopRefresh
			}
		}

		itemDef
		{
			name				join_button
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			rect				480 282 110 26
			text				"JOIN"
			descText			"Join the selected game"
			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			55
			forecolor			1 .682 0 1
			backcolor			0 0 .35 .8
			border				1
			bordercolor			0 0 .8 1
			visible				1
			mouseEnter { setitemcolor join_button bordercolor 1 1 1 1 }
			mouseExit  { setitemcolor join_button bordercolor 0 0 .8 1 }
			action
			{
				play			"sound/interface/button1.wav"
				uiScript			coopJoin
			}
		}

		itemDef
		{
			name				join_help
			type				ITEM_TYPE_TEXT
			rect				345 330 250 50
			text				"Both Quests must be on the same network. Open this screen after the host enters the level."
			font				2
			textscale			0.55
			textalign			ITEM_ALIGN_CENTER
			textalignx			125
			forecolor			.65 .75 1 1
			visible				1
			autowrapped
			decoration
		}

		itemDef
		{
			name				back_button
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				59 444 130 24
			text				@MENUS_BACK
			descText			@MENUS_BACKUP_ONE_MENU
			font				3
			textscale			1.1
			textalign			ITEM_ALIGN_CENTER
			textstyle			3
			textalignx			65
			textaligny			-1
			forecolor			1 .682 0 1
			visible				1
			action
			{
				play			"sound/interface/esc.wav"
				close			all
				open			mainMenu
			}
		}
	}
}
